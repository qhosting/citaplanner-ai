generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String?   @db.VarChar(150)
  startDateTime  DateTime? @map("start_datetime") @db.Timestamp(6)
  endDateTime    DateTime? @map("end_datetime") @db.Timestamp(6)
  clientName     String?   @map("client_name") @db.VarChar(100)
  clientPhone    String?   @map("client_phone") @db.VarChar(20)
  status         String?   @db.VarChar(20)
  description    String?
  branchId       String?   @map("branch_id") @db.Uuid
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  notes          String?
  reminderSent   Boolean?  @default(false) @map("reminder_sent")
  careSent       Boolean?  @default(false) @map("care_sent")
  updatedAt      DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  professionalId String?   @map("professional_id") @db.Uuid
  serviceId      String?   @map("service_id") @db.Uuid
  googleEventId  String?   @map("google_event_id") @db.VarChar(255)
  noShowRisk     Float?    @map("no_show_risk")
  noShowReasons  String?   @map("no_show_reasons")

  @@map("appointments")
}

model AutomationRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String?  @db.VarChar(255)
  isActive        Boolean? @default(false) @map("is_active")
  triggerType     String?  @map("trigger_type") @db.VarChar(100)
  delayHours      Int?     @default(0) @map("delay_hours")
  channel         String?  @db.VarChar(50)
  templateMessage String?  @map("template_message")

  @@map("automation_rules")
}

model BillingLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount      Decimal?  @db.Decimal(12, 2)
  currency    String?   @default("MXN") @db.VarChar(10)
  status      String?   @db.VarChar(20)
  provider    String?   @db.VarChar(20)
  description String?
  invoiceUrl  String?   @map("invoice_url")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("billing_logs")
}

model Branch {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?       @db.VarChar(100)
  address        String?
  phone          String?       @db.VarChar(20)
  manager        String?       @db.VarChar(100)
  status         String?       @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  transactions   Transaction[]

  @@map("branches")
}

model Client {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(255)
  phone             String?   @db.VarChar(50)
  email             String?   @db.VarChar(255)
  notes             String?
  skinType          String?   @map("skin_type") @db.VarChar(100)
  allergies         String?
  medicalConditions String?   @map("medical_conditions")
  consentAccepted   Boolean?  @default(false) @map("consent_accepted")
  consentDate       DateTime? @map("consent_date") @db.Timestamp(6)
  consentType       String?   @map("consent_type") @db.VarChar(100)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  treatmentHistory  Json?     @default("[]")

  @@map("clients")
}

model IntegrationLog {
  id             Int       @id @default(autoincrement())
  platform       String?   @db.VarChar(50)
  eventType      String?   @map("event_type") @db.VarChar(50)
  payload        Json?
  response       String?
  status         String?   @db.VarChar(20)
  branchId       String?   @map("branch_id") @db.Uuid
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("integration_logs")
}

model InventoryMovement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String?   @map("product_id")
  productName String?   @map("product_name")
  type        String?
  quantity    Int?
  reason      String?
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("inventory_movements")
}

model LandingSetting {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessName    String? @default("CitaPlanner Elite") @map("business_name") @db.VarChar(100)
  primaryColor    String? @default("#630E14") @map("primary_color") @db.VarChar(20)
  secondaryColor  String? @default("#C5A028") @map("secondary_color") @db.VarChar(20)
  templateId      String? @default("citaplanner") @map("template_id") @db.VarChar(20)
  slogan          String?
  aboutText       String? @map("about_text")
  address         String?
  contactPhone    String? @map("contact_phone") @db.VarChar(20)
  heroImageUrl    String? @map("hero_image_url")
  logoUrl         String? @map("logo_url")
  seoTitle        String? @map("seo_title") @db.VarChar(100)
  seoDescription  String? @map("seo_description")
  seoKeywords     String? @map("seo_keywords")
  latitude        Float?
  longitude       Float?
  whatsappPhone   String? @map("whatsapp_phone") @db.VarChar(20)
  footerText      String? @map("footer_text")
  socialInstagram String? @map("social_instagram") @db.VarChar(255)
  socialFacebook  String? @map("social_facebook") @db.VarChar(255)
  socialTwitter   String? @map("social_twitter") @db.VarChar(255)
  features        Json?   @default("{\"ai\": true, \"inventory\": true, \"marketing\": true}")
  heroSlides      Json?   @default("[]") @map("hero_slides")
  images          Json?   @default("[]")
  maintenanceMode Boolean @default(false) @map("maintenance_mode")
  services        Json?   @default("[]")
  stats           Json?   @default("[]")
  testimonials    Json?   @default("[]")
  serviceIds      Json?   @default("[]") @map("service_ids")
  productIds      Json?   @default("[]") @map("product_ids")
  heroVideoUrl    String? @map("hero_video_url")

  @@map("landing_settings")
}

model MarketingCampaign {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?   @db.VarChar(255)
  channel       String?   @db.VarChar(50)
  status        String?   @db.VarChar(50)
  content       String?
  targetSegment String?   @map("target_segment") @db.VarChar(100)
  subject       String?   @db.VarChar(255)
  sentCount     Int?      @default(0) @map("sent_count")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("marketing_campaigns")
}

model MarketingTemplate {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(255)
  content   String
  channel   String    @db.VarChar(50) // EMAIL, WHATSAPP, SMS
  subject   String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("marketing_templates")
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?  @db.VarChar(100)
  sku            String?  @unique @db.VarChar(50)
  category       String?  @db.VarChar(50)
  price          Decimal? @db.Decimal
  cost           Decimal? @db.Decimal
  stock          Int?
  minStock       Int?     @map("min_stock")
  status         String?  @default("ACTIVE") @db.VarChar(20)
  usage          String?  @db.VarChar(20)
  branchId       String?  @map("branch_id") @db.Uuid
  supplierName   String?  @map("supplier_name") @db.VarChar(100)
  supplierEmail  String?  @map("supplier_email") @db.VarChar(100)
  supplierPhone  String?  @map("supplier_phone") @db.VarChar(20)

  @@map("products")
}

model Professional {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String?
  role                String?
  email               String?
  weeklySchedule      Json?            @map("weekly_schedule")
  exceptions          Json?
  branchId            String?          @map("branch_id") @db.Uuid
  aurumEmployeeId     String?          @map("aurum_employee_id") @db.VarChar(50)
  serviceIds          String?          @map("service_ids")
  googleAccessToken   String?          @map("google_access_token")
  googleRefreshToken  String?          @map("google_refresh_token")
  googleCalendarId        String?          @map("google_calendar_id")
  calendarSyncEnabled     Boolean?         @default(false) @map("calendar_sync_enabled")
  googleCalendarSyncToken String?          @map("google_calendar_sync_token")
  icalToken               String?          @map("ical_token")
  taskAssignments     TaskAssignment[]

  @@map("professionals")
}

model Sale {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId        String?   @map("sale_id")
  items         Json?
  total         Decimal?  @db.Decimal
  paymentMethod String?   @map("payment_method")
  clientName    String?   @map("client_name")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("sales")
}

model Service {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String?  @db.VarChar(100)
  category         String?  @db.VarChar(50)
  duration         Int?
  price            Decimal? @db.Decimal
  description      String?
  status           String?  @default("ACTIVE") @db.VarChar(20)
  imageUrl         String?  @map("image_url")
  branchId         String?  @map("branch_id") @db.Uuid
  careInstructions String?  @map("care_instructions")

  @@map("services")
}

model Setting {
  key      String  @id @db.VarChar(50)
  value    Json?   @default("{}")

  @@map("settings")
}

model Transaction {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount         Decimal?  @db.Decimal(12, 2)
  mpPaymentId    String?   @map("mp_payment_id") @db.VarChar(100)
  mpStatus       String?   @map("mp_status") @db.VarChar(50)
  branchId       String?   @map("branch_id") @db.Uuid
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  branches       Branch?   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("transactions")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String?   @db.VarChar(100)
  phone             String?   @db.VarChar(20)
  email             String?   @db.VarChar(100)
  password          String?   @db.VarChar(100)
  role              String?   @db.VarChar(20)
  avatar            String?
  branchId          String?   @map("branch_id") @db.Uuid
  preferences       Json?     @default("{}")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  relatedId         String?   @map("related_id") @db.VarChar(100)
  pushSubscription  Json?     @map("push_subscription")
  skinType          String?   @map("skin_type") @db.VarChar(100)
  allergies         String?
  medicalConditions String?   @map("medical_conditions")
  loyaltyPoints     Int?      @default(0) @map("loyalty_points")
  refreshToken      String?   @map("refresh_token")
  resetToken        String?   @map("reset_token")
  resetTokenExpiry  DateTime? @map("reset_token_expiry") @db.Timestamp(6)
  @@map("users")
}

model MaintenanceTask {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dayOfWeek   Int              @map("day_of_week")
  taskName    String           @map("task_name") @db.VarChar(255)
  priority    Int              @default(1)
  assignments TaskAssignment[]

  @@map("maintenance_tasks")
}

model TaskAssignment {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date         DateTime        @db.Date
  taskId       String          @map("task_id") @db.Uuid
  assignedTo   String          @map("assigned_to") @db.Uuid
  status       String          @default("PENDING") @db.VarChar(20)
  completedAt  DateTime?       @map("completed_at") @db.Timestamp(6)
  professional Professional    @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  task         MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_assignments")
}

model Lead {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String    @db.VarChar(255)
  phone            String    @db.VarChar(20)
  email            String?   @db.VarChar(100)
  source           String    @default("MANUAL") @db.VarChar(50)
  status           String    @default("NEW") @db.VarChar(20)
  notes            String?
  estimatedValue   Float?    @map("estimated_value")
  interestLevel    String?   @default("MEDIUM") @map("interest_level") @db.VarChar(20)
  preferredContact String?   @default("WHATSAPP") @map("preferred_contact") @db.VarChar(50)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("leads")
}
