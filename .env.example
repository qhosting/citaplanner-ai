# Database
DATABASE_URL="postgres://user:password@localhost:5432/citaplanner_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development
DOMAIN_URL=http://localhost:5173
ROOT_DOMAIN=localhost
# Set to 'true' only in local dev to enable dev/dev bypass login (NEVER in production)
DEV_BYPASS_ENABLED=false

# Auth
NEXTAUTH_SECRET="your-secret-here"

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM="Your App <no-reply@example.com>"

# WAHA (WhatsApp)
WAHA_URL=http://localhost:3000

# Mercado Pago
MP_ACCESS_TOKEN=your-mercado-pago-token

# VAPID Keys (Web Push)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google APIs
GEMINI_API_KEY=your-gemini-api-key
API_KEY=your-gemini-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Cloudflare
CLOUDFLARE_API_TOKEN=your-cloudflare-token
CLOUDFLARE_ZONE_ID=your-zone-id

# Seed Credentials (Set these for production security)
SEED_ADMIN_NAME="Admin Master"
SEED_ADMIN_PHONE="admin"
SEED_ADMIN_EMAIL="admin@aurum.ai"
SEED_ADMIN_PASSWORD="your-secure-password"

QHOSTING_ADMIN_NAME="Admin QHosting"
QHOSTING_ADMIN_PHONE="admin@qhosting.net"
QHOSTING_ADMIN_EMAIL="admin@qhosting.net"
QHOSTING_ADMIN_PASSWORD="your-secure-password"

# GOD_MODE Super Admin (Nexus)
GOD_MODE_NAME="Super Admin Nexus"
GOD_MODE_PHONE="godadmin"
GOD_MODE_EMAIL="god@aurum.ai"
GOD_MODE_PASSWORD="your-godmode-password"
